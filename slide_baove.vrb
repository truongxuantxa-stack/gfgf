\frametitle{BACKUP B3.4: Guardrails \& Phát hiện Plateau \& Cron Job}
\textbf{7. Guardrails — Cơ chế an toàn}
    \begin{itemize}
        \scriptsize
        \item \textbf{TDEE clamp:} Giới hạn $TDEE_{\text{tĩnh}} \pm 30\%$ để ngăn outlier từ dữ liệu sai.
        \item \textbf{Minimum data:} Yêu cầu $\ge 5$ ngày nhật ký + $\ge 2$ lần cân để đảm bảo ý nghĩa thống kê.
        \item \textbf{Min valid weeks:} Cần đủ $\ge 2$ tuần hợp lệ mới cập nhật Adaptive TDEE cho User.
        \item \textbf{Confidence:} 7 ngày (High), 6 ngày (Medium), 5 ngày (Low) $\rightarrow$ Minh bạch độ tin cậy.
    \end{itemize}

    \vspace{0.1cm}
    \textbf{8. Phát hiện Plateau (Chững cân)}
    \begin{block}{\scriptsize Logic phát hiện Plateau}
        \scriptsize
        $\bullet$ \textbf{Nếu:} TDEE thực tế thấp hơn trên 5\% so với TDEE tĩnh (\texttt{diffPct < -5}).\\
        $\bullet$ \textbf{Hành động 1:} Gắn cờ chững cân (\texttt{isPlateauing = true}).\\
        $\bullet$ \textbf{Hành động 2:} Tính mục tiêu calo mới chặn dưới bằng BMR.\\
        $\bullet$ \textbf{Hành động 3:} Gửi thông báo: "Cơ thể đang thích ứng chuyển hóa".
    \end{block}

    \vspace{0.1cm}
    \textbf{9. Tự động hóa (Cron Job):} Chạy ngầm vào 0:00 sáng mỗi Thứ Hai để tổng hợp dữ liệu dinh dưỡng/cân nặng của toàn bộ người dùng trong tuần cũ, từ đó tự động tính toán và cập nhật TDEE cho tuần mới.
