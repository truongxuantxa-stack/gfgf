\frametitle{BACKUP B6.5: Quản trị Rủi ro API (Key Rotation \& Timeout)}
\begin{columns}[T]
        \begin{column}{0.48\textwidth}
            \modulelabel{1. Cơ chế xoay vòng khóa (Key Rotation)}
            \vspace{0.1cm}
            \begin{itemize}
                \small
                \item \textbf{Vấn đề:} API miễn phí của Gemini có giới hạn ngặt nghèo về Quota (lỗi \texttt{429 Too Many Requests}).
                \item \textbf{Giải pháp:} Cung cấp mảng nhiều API Keys vào biến môi trường \texttt{GOOGLE\_API\_KEY} (cách nhau bằng dấu phẩy).
                \item Hàm \texttt{executeWithKeyRotation()} tự động bắt lỗi 429. Nếu gặp, hệ thống sẽ \textbf{xoay vòng sang Key tiếp theo} và gọi lại thay vì văng lỗi, giúp tăng tính sẵn sàng cho Backend.
            \end{itemize}
        \end{column}

        \begin{column}{0.48\textwidth}
            \modulelabel{2. Giới hạn thời gian (Timeout 30s)}
            \vspace{0.1cm}
            \begin{itemize}
                \small
                \item \textbf{Vấn đề:} Đôi khi server AI bị treo (hanging), không phản hồi khiến giao diện người dùng phải chờ mãi mãi.
                \item \textbf{Giải pháp:} Cài đặt cơ chế chặn Timeout \textbf{30 giây} bằng \texttt{Promise.race}.
                \item Nếu quá 30s, API sẽ chủ động ném lỗi \textit{"Gemini API timeout"} để giải phóng luồng, giúp Frontend báo lỗi kịp thời để user thử lại thay vì đứng chờ vô tận.
            \end{itemize}
        \end{column}
    \end{columns}
